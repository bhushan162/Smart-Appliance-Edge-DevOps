# 1. Define the base image environment
FROM ubuntu:24.04

# 2. Establish the isolated application folder
WORKDIR /usr/src/app

# Prevent apt from prompting for user input (like timezone selection) which hangs Docker builds
ARG DEBIAN_FRONTEND=noninteractive

# 3. Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git cmake ninja-build gperf ccache dfu-util device-tree-compiler wget curl \
    python3-dev python3-venv python3-tk xz-utils file make gcc gcc-multilib \
    g++-multilib libsdl2-dev libmagic1

# 4. Create the virtual environment in a central system directory
RUN python3 -m venv /opt/venv

# 5. Prepend the venv to PATH so all subsequent RUN and CMD calls use it automatically
ENV PATH="/opt/venv/bin:$PATH"

# 6. Install West
RUN pip install --upgrade pip && \
    pip install west

# 7. Initialize Zephyr workspace, update modules, and install the Zephyr SDK
RUN west init -m https://github.com/zephyrproject-rtos/zephyr --mr v3.7.0 /opt/zephyrproject && \
    cd /opt/zephyrproject && \
    west update && \
    pip install -r zephyr/scripts/requirements.txt && \
    west zephyr-export 

# 8. Download and install Zephyr SDK (Using MINIMAL bundle ~42MB instead of 1.2GB full archive)
RUN cd /opt && \
    wget --tries=5 --timeout=60 https://github.com/zephyrproject-rtos/sdk-ng/releases/download/v0.16.8/zephyr-sdk-0.16.8_linux-x86_64_minimal.tar.xz && \
    tar -xf zephyr-sdk-0.16.8_linux-x86_64_minimal.tar.xz && \
    rm zephyr-sdk-0.16.8_linux-x86_64_minimal.tar.xz && \
    cd zephyr-sdk-0.16.8 && \
    ./setup.sh -t arm-zephyr-eabi -h -c

# 9. Set permanent environment variables for West, Zephyr, and QEMU
ENV ZEPHYR_BASE=/opt/zephyrproject/zephyr
ENV ZEPHYR_SDK_INSTALL_DIR=/opt/zephyr-sdk-0.16.8
ENV PATH="/opt/zephyr-sdk-0.16.8/sysroots/x86_64-pokysdk-linux/usr/bin:/opt/venv/bin:$PATH"

# ==============================================================================
# STAGE 5 ADDITIONS: Renode System Emulation
# ==============================================================================

# 10. Install Renode runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgtk-3-0 libglib2.0-0 uml-utilities screen && \
    rm -rf /var/lib/apt/lists/*

# 11. Download and install Antmicro Renode Portable (~100MB download only)
RUN mkdir -p /opt/renode && \
    cd /opt && \
    wget --tries=5 --timeout=60 https://builds.renode.io/renode-latest.linux-portable.tar.gz && \
    tar -xf renode-latest.linux-portable.tar.gz -C /opt/renode --strip-components=1 && \
    rm renode-latest.linux-portable.tar.gz

# 12. Add Renode to PATH
ENV PATH="/opt/renode:$PATH"