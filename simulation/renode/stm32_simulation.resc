# ======================================================================
# Renode Headless Simulation Script for STM32 Stand Mixer
# Hardware Test Scenario: Simulating Physical Slider Movement
# =====================================================================

$bin?=@build_stm32/zephyr/zephyr.elf

# 1. Create Machine & Load Board Schematic
mach create "smart-appliance-nucleo"
machine LoadPlatformDescription @simulation/renode/nucleo_f401re.repl

# 2. Flash Firmware
sysbus LoadELF $bin

# 3. Pipe USART2 to Terminal Console
showAnalyzer sysbus.usart2 Antmicro.Renode.Analyzers.LoggingUartAnalyzer

# 4. Let the RTOS boot cleanly into Idle (PB0-PB10 pull-down = Speed 0)
emulation RunFor "0.3"

# 5. Virtual Hand: Move slider to Speed 2 (Press PB2 contact)
echo "=== [TEST HARNESS] Moving slider to Speed 2 (Slow Mix)... ==="
gpioPortB.slider2 Press
emulation RunFor "1.0"

# 6. Virtual Hand: Move slider to Speed 6 (Release PB2, Press PB6)
echo "=== [TEST HARNESS] Moving slider to Speed 6 (Creaming High)... ==="
gpioPortB.slider2 Release
gpioPortB.slider6 Press
emulation RunFor "1.5"

# 7. Virtual Hand: Return slider to OFF (Release PB6)
echo "=== [TEST HARNESS] Returning slider to OFF (Speed 0)... ==="
gpioPortB.slider6 Release
emulation RunFor "1.5"
