using "platforms/cpus/stm32f4.repl"

UserLED: Miscellaneous.LED @ gpioPortA

gpioPortA:
    5 -> UserLED@0

slider0: Miscellaneous.Button @ gpioPortB 0 { IRQ -> gpioPortB@0 }
slider1: Miscellaneous.Button @ gpioPortB 1 { IRQ -> gpioPortB@1 }
slider2: Miscellaneous.Button @ gpioPortB 2 { IRQ -> gpioPortB@2 }
slider3: Miscellaneous.Button @ gpioPortB 3 { IRQ -> gpioPortB@3 }
slider4: Miscellaneous.Button @ gpioPortB 4 { IRQ -> gpioPortB@4 }
slider5: Miscellaneous.Button @ gpioPortB 5 { IRQ -> gpioPortB@5 }
slider6: Miscellaneous.Button @ gpioPortB 6 { IRQ -> gpioPortB@6 }
slider7: Miscellaneous.Button @ gpioPortB 7 { IRQ -> gpioPortB@7 }
slider8: Miscellaneous.Button @ gpioPortB 8 { IRQ -> gpioPortB@8 }
slider9: Miscellaneous.Button @ gpioPortB 9 { IRQ -> gpioPortB@9 }
slider10: Miscellaneous.Button @ gpioPortB 10 { IRQ -> gpioPortB@10 }