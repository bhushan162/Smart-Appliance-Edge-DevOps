pipeline {
    // 1. Where to execute the pipeline
    agent {
        docker {
            image 'zephyr-build-env:latest'
            args '-u root'
        }
    }

    parameters {
        choice(name: 'RELEASE_TYPE',
               choices: ['None (CI Build)', 'Patch', 'Minor', 'Major'],
               description: 'Select the type of release')
    }

    // // 2. Poll GitHub every 2 minutes for new commits
    // triggers {
    //     pollSCM('H/2 * * * *')
    // }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Calculate Version') {
            steps {
                script {
                    // Container runs as root but the workspace is owned by jenkins,
                    // so git refuses to work ("dubious ownership") unless we whitelist it.
                    sh 'git config --global --add safe.directory "$WORKSPACE"'

                    // Make sure tags are present, then read the latest one (fallback v0.0.0)
                    sh 'git fetch --tags --force || true'
                    def latestTag = sh(
                        script: 'git describe --tags --abbrev=0 2>/dev/null || echo "v0.0.0"',
                        returnStdout: true
                    ).trim()
                    echo "Latest Git Tag: ${latestTag}"

                    // Parse vMAJOR.MINOR.PATCH without regex Matcher objects
                    // (java.util.regex.Matcher is not serializable in CPS pipelines)
                    def parts = latestTag.replaceFirst('^v', '').tokenize('.')
                    int major = parts.size() > 0 ? parts[0].toInteger() : 0
                    int minor = parts.size() > 1 ? parts[1].toInteger() : 0
                    int patch = parts.size() > 2 ? parts[2].toInteger() : 0

                    if (params.RELEASE_TYPE == 'Patch') {
                        patch += 1
                        env.NEW_VERSION = "${major}.${minor}.${patch}"
                    } else if (params.RELEASE_TYPE == 'Minor') {
                        minor += 1
                        patch = 0
                        env.NEW_VERSION = "${major}.${minor}.${patch}"
                    } else if (params.RELEASE_TYPE == 'Major') {
                        major += 1
                        minor = 0
                        patch = 0
                        env.NEW_VERSION = "${major}.${minor}.${patch}"
                    } else {
                        // CI Build - append Jenkins build number
                        env.NEW_VERSION = "${major}.${minor}.${patch}-dev.${env.BUILD_NUMBER}"
                    }

                    echo "Building Version: ${env.NEW_VERSION}"

                    // Generate the Zephyr VERSION file before compiling
                    sh """
                        echo "VERSION_MAJOR = ${major}" > firmware/VERSION
                        echo "VERSION_MINOR = ${minor}" >> firmware/VERSION
                        echo "PATCHLEVEL = ${patch}" >> firmware/VERSION
                        echo "VERSION_TWEAK = 0" >> firmware/VERSION
                        if [ "${params.RELEASE_TYPE}" = "None (CI Build)" ]; then
                            echo "EXTRAVERSION = dev.${env.BUILD_NUMBER}" >> firmware/VERSION
                        fi
                        echo "Generated VERSION file:"
                        cat firmware/VERSION
                    """
                }
            }
        }

        stage('Static Analysis') {
            steps {
                echo "Running Cppcheck (We will add this in Stage 3)"
            }
        }

        stage('TEST SIMULATION - QEMU') {
            steps {
                sh '''
                    # 1. Build specifically for virtual QEMU target
                    west build -p always -b mps2_an521 firmware/ -d build_qemu

                    # 2. Run Python smoke test
                    python3 simulation/qemu/run_qemu_test.py
                '''
            }
        }

        stage('Build Firmware (RW610)') {
            steps {
                sh '''
                    # Build physical release artifact (Zephyr reads the VERSION file generated above)
                    west build -p always -b frdm_rw612 firmware/ -d rw610
                '''
            }
        }

        stage('TEST SIMULATION - RENODE') {
            steps {
                sh '''
                    # Execute headless Renode integration test suite
                    python3 simulation/renode/run_renode_test.py
                '''
            }
        }

        stage('Deploy & Tag (Release Only)') {
            // Only run for a release type selected on the main branch.
            // 'branch' only works in Multibranch jobs, so we check GIT_BRANCH as well.
            when {
                allOf {
                    expression { env.BRANCH_NAME == 'main' || env.GIT_BRANCH == 'origin/main' }
                    expression { params.RELEASE_TYPE != 'None (CI Build)' }
                }
            }
            steps {
                withCredentials([usernamePassword(credentialsId: 'github_login',
                                                  usernameVariable: 'GIT_USER',
                                                  passwordVariable: 'GIT_PASS')]) {
                    // Single quotes: the shell expands the secrets, Groovy never sees them
                    sh '''
                        git tag "v${NEW_VERSION}"
                        git push "https://${GIT_USER}:${GIT_PASS}@github.com/bhushan162/Smart-Appliance-Edge-DevOps.git" "v${NEW_VERSION}"
                    '''
                }
                echo "Successfully tagged and released v${env.NEW_VERSION}"
            }
        }
    }

    // 4. Actions to run depending on build outcomes
    post {
        always {
            archiveArtifacts artifacts: 'rw610/zephyr/zephyr.bin, rw610/zephyr/zephyr.elf', allowEmptyArchive: true
            echo 'Cleaning up the workspace...'
            cleanWs()
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Sending alerts...'
        }
    }
}