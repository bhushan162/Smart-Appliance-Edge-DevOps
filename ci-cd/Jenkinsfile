pipeline {
    // 1. Where to execute the pipeline
    agent {
        docker {
            image 'zephyr-build-env:latest' // The Docker image you want to use
            args '-u root'         // Optional: Run container as root user if needed
        }
    }

    // Define the parameter dropdown
    parameters {
        choice(name: 'RELEASE_TYPE', choices: ['None (CI Build)', 'Patch', 'Minor', 'Major'], description: 'Select the type of release')
    }

    // 2. Poll GitHub every 2 minutes for new commits
    triggers {
        pollSCM('H/2 * * * *')
    }

    environment {
        // Fallback to v0.0.0 if no tags exist yet
        LATEST_GIT_TAG = "${sh(script: 'git describe --tags --abbrev=0 2>/dev/null || echo "v0.0.0"', returnStdout: true).trim()}"
    }

    // 3. The execution steps divided into stages
    stages {
        stage('Checkout') {
            steps {
                // Jenkins automatically checks out the code before the pipeline starts
                checkout scm
            }
        }

        stage('Calculate Version') {
            steps {
                script {
                    echo "Latest Git Tag: ${LATEST_GIT_TAG}"

                    // Regex to parse vMAJOR.MINOR.PATCH
                    def match = LATEST_GIT_TAG =~ /v(\d+)\.(\d+)\.(\d+)/
                    def major = match ? match[0][1].toInteger() : 0
                    def minor = match ? match[0][2].toInteger() : 0
                    def patch = match ? match[0][3].toInteger() : 0

                    if (params.RELEASE_TYPE == 'Patch') {
                        patch += 1
                        env.NEW_VERSION = "${major}.${minor}.${patch}"
                    } else if (params.RELEASE_TYPE == 'Minor') {
                        minor += 1
                        patch = 0
                        env.NEW_VERSION = "${major}.${minor}.${patch}"
                    } else if (params.RELEASE_TYPE == 'Major') {
                        major += 1
                        minor = 0
                        patch = 0
                        env.NEW_VERSION = "${major}.${minor}.${patch}"
                    } else {
                        // CI Build - append Jenkins build number
                        env.NEW_VERSION = "${major}.${minor}.${patch}-dev.${env.BUILD_NUMBER}"
                    }

                    echo "Building Version: ${env.NEW_VERSION}"

                    // Dynamically generate the Zephyr VERSION file before compiling
                    sh """
                        echo "VERSION_MAJOR = ${major}" > firmware/VERSION
                        echo "VERSION_MINOR = ${minor}" >> firmware/VERSION
                        echo "VERSION_PATCH = ${patch}" >> firmware/VERSION
                        if [ "${params.RELEASE_TYPE}" = "None (CI Build)" ]; then
                            echo "EXTRAVERSION = dev.${env.BUILD_NUMBER}" >> firmware/VERSION
                        fi
                        echo "Generated VERSION file:"
                        cat firmware/VERSION
                    """
                }
            }
        }

        stage('Static Analysis') {
            steps {
                echo "Running Cppcheck (We will add this in Stage 3)"
            }
        }

        stage('TEST SIMULATION - QEMU') {
            steps {
                sh '''
                # 1. Build specifically for virtual QEMU target
                west build -p always -b mps2_an521 firmware/ -d build_qemu

                # 2. Run your Python smoke test
                python3 simulation/qemu/run_qemu_test.py
                '''
            }
        }

        stage('Build Firmware (RW610)') {
            steps {
                sh '''
                    # Build physical release artifact (Zephyr reads the VERSION file we generated)
                    west build -p always -b frdm_rw612 firmware/ -d rw610
                '''
            }
        }

        stage('TEST SIMULATION - RENODE') {
            steps {
                sh '''
                    # Execute headless Renode integration test suite
                    python3 simulation/renode/run_renode_test.py
                '''
            }
        }

        stage('Deploy & Tag (Release Only)') {
            // Conditional execution: Only run if user selected a release type and we are on the main branch
            when {
                branch 'main'
                expression { params.RELEASE_TYPE != 'None (CI Build)' }
            }
            steps {
                script {
                    echo "Deploying Release v${env.NEW_VERSION}..."
                    // 1. Tag the repository and push
                    sh """
                        git tag v${env.NEW_VERSION}
                        git push origin v${env.NEW_VERSION}
                    """
                    echo "Successfully tagged and released v${env.NEW_VERSION}"
                }
            }
        }
    }

    // 4. Actions to run depending on build outcomes
    post {
        always {
            // Archive the compiled binaries in Jenkins for debugging (kept for both CI and Release builds)
            archiveArtifacts artifacts: 'rw610/zephyr/zephyr.bin, rw610/zephyr/zephyr.elf', allowEmptyArchive: true
            echo 'Cleaning up the workspace...'
            // Clean workspace to ensure next build is pristine and temporary VERSION file is removed
            cleanWs()
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Sending alerts...'
        }
    }
}